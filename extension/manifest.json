{
  "manifest_version": 3,
  "name": "TruthLens",
  "version": "0.1.0",
  "permissions": ["scripting", "activeTab", "storage", "alarms"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "dist/background.js" },
  "content_scripts": [{ "matches": ["<all_urls>"], "js": ["dist/content.js"] }],
  "action": { "default_popup": "dist/popup.html" },
  "options_ui": { "page": "dist/options.html", "open_in_tab": false }
}
